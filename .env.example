# Server-only configuration. Not read automatically; see DEV.md.
HOST=127.0.0.1
PORT=3001
PADMA_DB=.data/padma.sqlite
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
NODE_ENV=development
# Optional Web Push contact (keys live in .data/vapid.json)
# VAPID_SUBJECT=mailto:notify@example.com
# Optional OpenAI TTS for vocab word audio (server-only)
# OPENAI_API_KEY=
# PADMA_TTS_VOICE=alloy
# Optional sign-in through Quazar (QUAZAR_SSO.md); secret only on the server
# QUAZAR_CLIENT_ID=padma
# QUAZAR_CLIENT_SECRET=
# QUAZAR_WEB_URL=https://quazar-msg.ru
# QUAZAR_API_URL=https://quazar-msg.ru/api
# PADMA_URL=http://localhost:5173
