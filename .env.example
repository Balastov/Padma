# Server-only configuration. Not read automatically; see DEV.md.
HOST=127.0.0.1
PORT=3001
PADMA_DB=.data/padma.sqlite
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
NODE_ENV=development
