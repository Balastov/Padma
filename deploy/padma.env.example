NODE_ENV=production
HOST=127.0.0.1
PORT=3001
PADMA_DB=/var/lib/padma/padma.sqlite
APP_ORIGIN=https://padma.ru,https://www.padma.ru
PADMA_BACKUP_DIR=/var/lib/padma/backups
# Attachments (homework, chat, library). Default: "files" next to PADMA_DB.
# A separate disk can be mounted right there; another path must also be added
# to ReadWritePaths in padma.service.
PADMA_FILES=/var/lib/padma/files
