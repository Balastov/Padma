[Unit]
Description=Back up Padma SQLite database

[Service]
Type=oneshot
User=padma
Group=padma
WorkingDirectory=/var/www/padma/current
EnvironmentFile=/etc/padma/padma.env
ExecStart=/opt/padma/node/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/padma
